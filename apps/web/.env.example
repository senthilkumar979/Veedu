# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Legacy fallback (deprecated): NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only — Google OAuth callback + invite accept
SUPABASE_SERVICE_ROLE_KEY=



# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# AI — Gemini (modules stub without this key)
GEMINI_API_KEY=
# Optional model override (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# App (used for OAuth redirects + invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google Calendar + Contacts (optional)
# Create OAuth client (Web) with redirect: {NEXT_PUBLIC_APP_URL}/api/google/callback
# Enable "Google Calendar API" and "People API" in the same Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; falls back to SUPABASE_SERVICE_ROLE_KEY / a generated secret
# GOOGLE_OAUTH_STATE_SECRET=
